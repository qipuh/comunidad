# Database Configuration
DATABASE_URL=postgresql://comunidad_user:comunidad_pass@localhost:5432/comunidad_db
# For development with SQLite:
# DATABASE_URL=sqlite:///./test.db

# Security
SECRET_KEY=your-secret-key-change-in-production
ENCRYPTION_KEY=your-base64-encrypted-key-change-in-production

# External APIs
RENIEC_API_TOKEN=your_reniec_token
FACTURIZA_API_KEY=your_facturiza_api_key
SUNAT_API_TOKEN=your_sunat_token

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
